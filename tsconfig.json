{
  "compilerOptions": {
    "declaration": true,
    "module": "nodenext",
    "target": "ES2022",
    "moduleResolution": "nodenext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "./dist/",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "strict": false,
    "rootDir": "./src"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "test/**/*.*",
    "./jest.config.cjs",
    "./dist",
    "./node_modules"
  ]
}
